+/// Join an explicitly selected set without linking it to any outside surface.
+/// The caller supplies the current window's tabs and splits on the main thread.
+pub fn joinBroadcastGroup(
+    self: *App,
+    rt_app: *apprt.App,
+    targets: []const ?*apprt.Surface,
+) bool {
+    if (targets.len == 0 or targets.len > self.surfaces.items.len) return false;
+    for (targets) |maybe_surface| {
+        const surface = maybe_surface orelse return false;
+        if (std.mem.indexOfScalar(*apprt.Surface, self.surfaces.items, surface) == null)
+            return false;
+    }
+
+    var outside: std.StaticBitSet(max_broadcast_groups) = .initEmpty();
+    for (self.surfaces.items) |surface| {
+        if (std.mem.indexOfScalar(?*apprt.Surface, targets, surface) != null) continue;
+        if (surface.core().broadcast_group) |group| outside.set(group);
+    }
+    const group = windowBroadcastGroup(outside, targets[0].?.core().broadcast_group) orelse {
+        log.warn("no broadcast group available for the current window", .{});
+        return false;
+    };
+
+    for (targets) |surface| surface.?.core().broadcast_group = group;
+    for (targets) |surface| syncBroadcastGroup(rt_app, surface.?.core());
+    return true;
+}
+
+fn windowBroadcastGroup(outside: std.StaticBitSet(max_broadcast_groups), current: ?u4) ?u4 {
+    if (current) |group| {
+        if (!outside.isSet(group)) return group;
+    }
+    const unused = outside.complement().findFirstSet() orelse return null;
+    return @intCast(unused);
+}
+
+test "window broadcast group stays local and idempotent" {
+    const testing = std.testing;
+    var outside: std.StaticBitSet(max_broadcast_groups) = .initEmpty();
+    try testing.expectEqual(@as(?u4, 0), windowBroadcastGroup(outside, null));
+    try testing.expectEqual(@as(?u4, 3), windowBroadcastGroup(outside, 3));
+    outside.set(0);
+    outside.set(3);
+    try testing.expectEqual(@as(?u4, 1), windowBroadcastGroup(outside, 3));
+    try testing.expectEqual(@as(?u4, 1), windowBroadcastGroup(outside, 1));
+    outside = .initFull();
+    try testing.expectEqual(@as(?u4, null), windowBroadcastGroup(outside, null));
+    try testing.expectEqual(@as(?u4, null), windowBroadcastGroup(outside, 3));
+}
